.claude/

# Sprint 0 / V3-Dev-Tier throwaway spike code (per SPRINT_0_RUNBOOK.md §5)
spikes/

# Local terraform / deploy scratch (never commit)
infra/gcp/terraform.tfvars.bak
infra/gcp/tfplan.json
infra/gcp/tfplan.txt

# Local agent scratch (goal-judge runs, ad-hoc outputs)
workspace/

# GoalJudge §8.3 confirmation-gate: real Langfuse verdict export (local download,
# not tracked). The committed langfuse_replay_sample.json is the load-path smoke;
# point GOALJUDGE_LANGFUSE_EXPORT at the real export to run the behavioral gate.
tests/fixtures/goaljudge/langfuse_replay_export*.json

# PR draft bodies (local only)
.github-pr-body*.md

# Local marketing draft (not for the repo)
docs/MARKETING_REPORT.md

# Ad-hoc debug scripts (local only)
scripts/_dbg_*.py

# Captured test output (local only)
test_log.txt

# GitHub branch-ruleset export (local download, not tracked)
AgentsFrameworkRules.json

# Accidental root npm lockfile (frontend lockfile lives in frontend/)
/package-lock.json

# Presentations — LibreOffice / Office temp and lock artifacts
presentations/*.tmp
presentations/.~lock.*
presentations/~$*

# Guardrails ONNX artifact (model.onnx + tokenizer.json + config.json; ~184MB).
# Shipped via git-LFS / fetch-at-build; absent in default checkout => graceful degrade.
services/governance/artifacts/

# Eval-skill workspace run artifacts (regenerable; keep one canonical `outputs/` copy).
# Timestamped duplicates of a stable-named output (e.g. coded.20260614T141843.jsonl next to
# coded.jsonl) are pure re-runs — never commit new ones. Already-tracked run-1/ evidence stays
# tracked (git keeps tracking existing files); this only stops NEW timestamped re-runs landing.
docs/skills/*-workspace/**/coded.[0-9]*T[0-9]*.jsonl
