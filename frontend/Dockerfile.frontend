# Dockerfile.frontend — Production Next.js 15 standalone for Cloud Run
# Multi-stage build: deps → build → minimal runtime.
#
# Build:  docker build -f Dockerfile.frontend -t agent-frontend:dev ./frontend
# Run:    docker run -p 3000:3000 -e MIDDLEWARE_URL=http://host.docker.internal:8080 agent-frontend:dev
# Probe:  curl http://localhost:3000

# ─── Stage 1: install dependencies ─────────────────────────────────
FROM node:20-alpine AS deps

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@10 --activate

COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile --prod=false

# ─── Stage 2: build ────────────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

# Reuse corepack/pnpm from deps — avoids registry fetch during build
COPY --from=deps /usr/local/lib/node_modules/corepack /usr/local/lib/node_modules/corepack
RUN corepack enable
COPY --from=deps /app/node_modules ./node_modules
COPY . .

ENV NEXT_TELEMETRY_DISABLED=1

# T R.5 / FR-A4 §6: NEXT_PUBLIC_* is inlined at `next build`. Default OFF keeps
# shadow→canary (InMemoryEngineDb). Pass --build-arg NEXT_PUBLIC_FF_DURABLE_ENGINE=1
# (deploy_gcp.sh maps enable_durable_engine from tfvars) for a flag-on image.
ARG NEXT_PUBLIC_FF_DURABLE_ENGINE=0
ENV NEXT_PUBLIC_FF_DURABLE_ENGINE=$NEXT_PUBLIC_FF_DURABLE_ENGINE

RUN pnpm build

# ─── Stage 3: production runtime ───────────────────────────────────
FROM node:20-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

# T R.14 (a) / FR-A4 §6: the runner stage is a fresh FROM, so ARGs from the
# builder do NOT cross over. Re-declare the durable-engine flag here and bake
# it into a final-image LABEL so the pinned @sha256 digest is self-describing —
# `docker inspect` returns what the image was built with, which the
# deploy_gcp.sh flag↔var guard reads to catch a stale pin (operator flips
# enable_durable_engine without rebuilding). NEXT_PUBLIC_* is already inlined
# into the bundle at build time; this LABEL is the deploy-time witness.
ARG NEXT_PUBLIC_FF_DURABLE_ENGINE=0
LABEL org.agentsframework.ff_durable_engine=$NEXT_PUBLIC_FF_DURABLE_ENGINE

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

COPY --from=builder /app/public ./public

RUN mkdir .next && chown nextjs:nodejs .next

COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:3000/ || exit 1

CMD ["node", "server.js"]
