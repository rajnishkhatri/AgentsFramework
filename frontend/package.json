{
  "name": "agent-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "V3-Dev-Tier Next.js 15 frontend for the ReAct agent. Implements the four-ring architecture: wire/ (Zod kernels), trust-view/ (read-only), ports/ (vendor-neutral interfaces), adapters/ (SDK isolation), translators/ (pure functions), transport/ (SSE), composition/ (single profile switch). See docs/Architectures/FRONTEND_ARCHITECTURE.md and docs/style-guides/STYLE_GUIDE_FRONTEND.md.",
  "type": "module",
  "exports": {
    "./ui": {
      "types": "./dist/types/components/ui/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "tokens:build": "node design/style-dictionary.config.mjs",
    "tauri": "PATH=\"$HOME/.cargo/bin:$PATH\" tauri",
    "tauri:dev": "PATH=\"$HOME/.cargo/bin:$PATH\" tauri dev",
    "tauri:build": "PATH=\"$HOME/.cargo/bin:$PATH\" tauri build",
    "cap:sync": "PATH=\"/opt/homebrew/bin:$PATH\" cap sync ios",
    "cap:open": "cap open ios",
    "cap:run": "PATH=\"/opt/homebrew/bin:$PATH\" cap run ios",
    "dev": "pnpm tokens:build && next dev",
    "build": "pnpm tokens:build && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:arch": "vitest run tests/architecture",
    "typecheck": "tsc --noEmit",
    "storybook": "pnpm tokens:build && storybook dev -p 6006",
    "build-storybook": "pnpm tokens:build && storybook build",
    "build:lib": "pnpm tokens:build && tsup && tsc -p tsconfig.lib.json",
    "regen:wire-types": "openapi-typescript ../openapi.yaml -o lib/wire-types.ts",
    "check:wire-types": "openapi-typescript ../openapi.yaml -o /tmp/agent-wire-types.ts && diff -u lib/wire-types.ts /tmp/agent-wire-types.ts",
    "wire-schema-snapshot": "tsx scripts/snapshot_wire_schemas.ts",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:t1": "playwright test --grep-invert '@t2|@t3|@visual' --ignore-snapshots",
    "test:e2e:t2": "MOCK_MIDDLEWARE=1 MIDDLEWARE_URL=http://localhost:8765 playwright test e2e/integration/",
    "test:e2e:t3": "playwright test e2e/full-stack/ e2e/smoke.spec.ts",
    "test:e2e:stress": "playwright test e2e/full-stack/planning-stress.spec.ts --project=chromium-desktop --global-timeout=600000",
    "test:e2e:mem": "playwright test e2e/full-stack/memory-multisession.spec.ts --project=chromium-desktop --global-timeout=900000",
    "test:e2e:phaseb": "playwright test e2e/full-stack/phaseb-recall-reject.spec.ts --project=chromium-desktop --global-timeout=900000",
    "test:e2e:coach-workos": "E2E_AUTHENTICATED=1 playwright test e2e/coach-auth-guard.spec.ts e2e/full-stack/coach-workos-local.spec.ts --project=chromium-desktop",
    "test:e2e:learn": "playwright test --project=learn-e2e",
    "test:e2e:learn:full": "E2E_BYPASS_AUTH=1 playwright test --project=learn-e2e full-session.spec.ts",
    "test:e2e:test-mode": "E2E_BYPASS_AUTH=1 playwright test --project=learn-e2e test-mode.spec.ts",
    "test:e2e:a1-reveal": "E2E_BYPASS_AUTH=1 playwright test --project=learn-e2e e2e/learn/validate_a1_reveal.spec.ts",
    "test:e2e:continuity": "E2E_BYPASS_AUTH=1 playwright test --project=learn-e2e e2e/learn/validate_continuity_fixes.spec.ts",
    "convert:test01": "tsx scripts/convert_test01_english.ts",
    "test:e2e:matrix": "playwright test e2e/cross-browser/",
    "test:e2e:visual": "playwright test e2e/visual/ --project=chromium-desktop",
    "test:e2e:visual:update": "playwright test e2e/visual/ --project=chromium-desktop --update-snapshots",
    "test:e2e:visual:auth": "E2E_BYPASS_AUTH=1 playwright test e2e/visual/ --project=chromium-desktop",
    "test:e2e:visual:auth:update": "E2E_BYPASS_AUTH=1 playwright test e2e/visual/ --project=chromium-desktop --update-snapshots",
    "mock-middleware": "tsx e2e/fixtures/mock-middleware.ts",
    "check:csp": "tsx scripts/check_csp_strict.ts middleware.ts",
    "check:iframe": "tsx scripts/check_iframe_sandbox.ts",
    "check:composer": "tsx scripts/check_composer_keyboard.ts components/chat/Composer.tsx",
    "check:secrets-env": "tsx scripts/check_secrets_in_public_env.ts",
    "check:jwt-storage": "tsx scripts/check_jwt_storage.ts",
    "check:sprint-story": "tsx scripts/check_sprint_story.ts",
    "check:axe-a11y": "tsx scripts/check_axe_a11y.ts",
    "check:bundle-budget": "tsx scripts/check_bundle_budget.ts",
    "db:migrate:engine": "node scripts/migrate_engine.mjs"
  },
  "dependencies": {
    "@capacitor-community/safe-area": "^7.0.0",
    "@capacitor/app": "^7.1.2",
    "@capacitor/browser": "^7.0.5",
    "@capacitor/core": "^7.6.7",
    "@capacitor/ios": "^7.6.7",
    "@capacitor/keyboard": "^7.0.6",
    "@capacitor/status-bar": "^7.0.6",
    "@copilotkit/react-core": "^1.56.3",
    "@copilotkit/react-ui": "^1.56.3",
    "@copilotkit/runtime": "^1.56.3",
    "@langchain/langgraph-sdk": "^1.8.9",
    "@neondatabase/serverless": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@radix-ui/react-scroll-area": "^1.2.12",
    "@radix-ui/react-separator": "^1.1.10",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.10",
    "@tailwindcss/postcss": "^4.2.4",
    "@types/js-yaml": "^4.0.9",
    "@workos-inc/authkit-nextjs": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "geist": "^1.7.2",
    "js-yaml": "^4.3.1",
    "lucide-react": "^1.21.0",
    "next": "^15.5.18",
    "next-themes": "^0.4.3",
    "pg": "^8.21.0",
    "postcss": "^8.5.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.4",
    "ts-fsrs": "^5.4.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.2",
    "@capacitor/cli": "^7.6.7",
    "@playwright/test": "^1.59.1",
    "@storybook/addon-a11y": "^9.1.20",
    "@storybook/addon-docs": "^9.1.20",
    "@storybook/nextjs-vite": "^9.1.20",
    "@tauri-apps/cli": "^2.11.3",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^22.7.5",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^9.13.0",
    "eslint-config-next": "^15.0.3",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "iron-session": "^8.0.4",
    "jose": "^6.2.2",
    "jsdom": "^25.0.1",
    "openapi-typescript": "^7.4.4",
    "storybook": "^9.1.20",
    "style-dictionary": "^5.5.0",
    "ts-morph": "^24.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vite": "^7.3.5",
    "vitest": "^4.1.0"
  },
  "packageManager": "pnpm@10.33.2+sha512.a90faf6feeab71ad6c6e57f94e0fe1a12f5dcc22cd754db40ae9593eb6a3e0b6b12e3540218bb37ae083404b1f2ce6db2a4121e979829b4aff94b99f49da1cf8"
}
