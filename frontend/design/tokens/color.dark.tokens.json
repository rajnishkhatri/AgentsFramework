{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "AgentsFramework UI — dark theme color tokens (DTCG). Explicit derived tokens use richer per-mode mix percentages than light. Derived $values are the oklab color-mix recipes resolved to sRGB; keep the recipe in $extensions for regeneration if a primitive changes.",
  "color": {
    "$type": "color",

    "bg":      { "$value": "#241c15", "$description": "Dark base background — Cocoa (frozen v13)." },
    "fg":      { "$value": "#f9f7f5", "$description": "Primary foreground / text." },
    "muted":   { "$value": "#e4e1da", "$description": "Secondary text — brightened for dark legibility (frozen v11)." },
    "accent":  { "$value": "#e5967c", "$description": "Coral accent, dark-tuned (frozen v16) — same hue as light #d87758, lifted L / trimmed C." },
    "danger":  { "$value": "#e57368", "$description": "Error / destructive, dark-tuned." },
    "success": { "$value": "#5cba86", "$description": "Success / complete, dark-tuned." },
    "warning": { "$value": "#e3b357", "$description": "Warning / caution, dark-tuned (frozen v20)." },

    "accent-light": {
      "$value": "rgba(229, 150, 124, 0.22)",
      "$description": "Accent wash for badges/hover. Per-mode: 22% in dark (vs 15% light).",
      "$extensions": { "com.agentsframework.mix": "color-mix(in oklab, {color.accent} 22%, transparent)" }
    },
    "border": {
      "$value": "rgba(248, 248, 248, 0.141)",
      "$description": "Hairline border. Per-mode: fg 14% in dark (vs 12% light).",
      "$extensions": { "com.agentsframework.mix": "color-mix(in oklab, {color.fg} 14%, transparent)" }
    },
    "border-light": {
      "$value": "rgba(245, 245, 245, 0.102)",
      "$description": "Softer hairline.",
      "$extensions": { "com.agentsframework.mix": "color-mix(in oklab, {color.fg} 10%, transparent)" }
    },
    "surface": {
      "$value": "#322a24",
      "$description": "Raised surface (cards, sidebar, menus). Per-mode: bg 92% / fg 8% in dark.",
      "$extensions": { "com.agentsframework.mix": "color-mix(in oklab, {color.bg} 92%, {color.fg} 8%)" }
    },
    "surface-sunken": {
      "$value": "#3f3831",
      "$description": "Sunken/inset surface. Per-mode: bg 85% / fg 15% in dark.",
      "$extensions": { "com.agentsframework.mix": "color-mix(in oklab, {color.bg} 85%, {color.fg} 15%)" }
    },
    "selected": {
      "$value": "rgba(245, 245, 245, 0.102)",
      "$description": "Selected/hover overlay. Per-mode: fg 10% in dark.",
      "$extensions": { "com.agentsframework.mix": "color-mix(in oklab, {color.fg} 10%, transparent)" }
    },
    "placeholder": {
      "$value": "#9c998f",
      "$description": "Dark-only input placeholder — dimmed below --color-muted (frozen v11 safeguard)."
    },

    "bucket-rhetoric":           { "$value": "#e5967c", "$description": "Skill-bucket accent: Rhetoric (dark) — FR-A3." },
    "bucket-usage":              { "$value": "#d6a45a", "$description": "Skill-bucket accent: Usage (dark) — FR-A3." },
    "bucket-punctuation":        { "$value": "#6bbfa9", "$description": "Skill-bucket accent: Punctuation (dark) — FR-A3." },
    "bucket-organization":       { "$value": "#9bb56e", "$description": "Skill-bucket accent: Organization (dark) — FR-A3." },
    "bucket-sentence-structure": { "$value": "#84a6cc", "$description": "Skill-bucket accent: Sentence Structure (dark) — FR-A3." },
    "bucket-conciseness":        { "$value": "#c08fb4", "$description": "Skill-bucket accent: Conciseness (dark) — FR-A3." }
  }
}
